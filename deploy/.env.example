# Copy to deploy/.env and fill in the secrets. Everything else has a default.

# --- Domains (DNS A records pointing at this server) ---
APP_DOMAIN=treehouse.example.com
VOICE_DOMAIN=voice.treehouse.example.com

# --- Secrets (required) ---
POSTGRES_PASSWORD=
# Voice. Make a pair with: docker run --rm livekit/livekit-server:v1.9.3 generate-keys
# (secret 32+ characters). LiveKit sends its webhooks to
# https://APP_DOMAIN/api/livekit/webhook signed with this pair; the server
# rejects any other signature.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: GIFs are off without it.
GIPHY_API_KEY=

# --- Server (defaults shown) ---
# TREEHOUSE_IMAGE=treehouse:latest
# TREEHOUSE_REPLICAS=1          # 1 or 2
# LOG_FORMAT=json               # json | pretty
# LOG_LEVEL=info                # tracing filter, e.g. info,treehouse_server=debug
# DB_MAX_CONNECTIONS=10         # per replica
# RUN_MIGRATIONS=true           # safe with 2 replicas (advisory lock)
# SETUP_INVITE_TTL=120          # minutes, 15..1440
# MAX_VOICE_ROOMS=3             # 1..6
# SHUTDOWN_GRACE_SECS=10
