// Public front door for the treehouse-releases R2 bucket (DMG, Windows installer and in-app update feed).
// The bucket itself has no public access; this Worker serves it on workers.dev,
// blocks some countries and rate-limits per IP. Deploy: `task r2:deploy`.
{
  "name": "treehouse-releases",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "treehouse-releases" }],
  "ratelimits": [
    // Feed checks: an install asks every 6 h, so this only stops abuse.
    { "name": "FEED_LIMIT", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } },
    // DMG / update tarball downloads.
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "4202", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": { "BLOCKED_COUNTRIES": "RU,BY" }
}
