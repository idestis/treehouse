# Release tooling (Taskfile). Copy to .env. Server settings live in deploy/.env.example.

# Apple Developer Team ID (10 characters); a "Developer ID Application" cert
# for it must be in the login keychain.
TEAM_ID=
# notarytool keychain profile (`task notary:setup`). Reuse another app's, e.g. kite-notary.
# NOTARY_PROFILE=treehouse-notary

# Releases bucket and its Worker URL (`task r2:setup`). No trailing slash.
# Baked into the app as the update feed: R2_PUBLIC_URL/latest.json
R2_BUCKET=treehouse-releases
R2_PUBLIC_URL=

# Optional: one-line release summary from a local Ollama model.
# OLLAMA_MODEL=qwen2.5-coder:7b

# Docker image platform for the server (your VPS). linux/arm64 for ARM servers.
# SERVER_PLATFORM=linux/amd64

# Local dev server (task server:dev): GIF search. Get an API (not SDK) key at
# developers.giphy.com. It stays on the server; the app never sees it.
# GIPHY_API_KEY=
