{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treehouse",
  "version": "0.1.0",
  "identifier": "app.treehouse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Treehouse",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
