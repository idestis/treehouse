# Copy to .env and fill in.
APP_DOMAIN=chat.example.com
VOICE_DOMAIN=voice.example.com

PUBLIC_URL=https://chat.example.com
LIVEKIT_URL=wss://voice.example.com

# Generate both with: openssl rand -hex 24
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret

ROOM_NAME=hangout
